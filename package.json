{
  "name": "agent-host",
  "version": "1.0.0",
  "description": "Desktop host that pairs a phone with local coding agents over the existing sealed tunnel",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/cli.js",
  "bin": {
    "agent-host": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaLEntropy/Agent-host.git"
  },
  "bugs": {
    "url": "https://github.com/AriaLEntropy/Agent-host/issues"
  },
  "homepage": "https://github.com/AriaLEntropy/Agent-host#readme",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "measure:snapshot": "tsx scripts/snapshot-size.ts",
    "smoke:bus": "tsx scripts/bus-smoke.ts",
    "smoke:commands": "tsx scripts/command-idempotency.ts",
    "smoke:restart": "tsx scripts/command-host-restart.ts",
    "smoke:pair-refresh": "tsx scripts/pair-refresh-smoke.ts",
    "smoke:ws": "tsx scripts/ws-subscribe.ts",
    "probe:capacity": "tsx scripts/capacity-probe.ts",
    "probe:latency": "tsx scripts/latency-probe.ts",
    "smoke:admin": "tsx scripts/admin-smoke.ts",
    "test": "tsx --test --test-concurrency=1 test/tunnel/*.test.ts test/bus/*.test.ts test/connectors/*.test.ts"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
