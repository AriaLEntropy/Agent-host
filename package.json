{
  "name": "agent-host",
  "version": "1.0.0",
  "description": "Desktop host that pairs a phone with local coding agents over the existing sealed tunnel",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "dist/desktop/main.js",
  "bin": {
    "agent-host": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaLEntropy/Agent-host.git"
  },
  "bugs": {
    "url": "https://github.com/AriaLEntropy/Agent-host/issues"
  },
  "homepage": "https://github.com/AriaLEntropy/Agent-host#readme",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && tsx scripts/copy-desktop-assets.ts",
    "package:release": "tsx scripts/package-release.ts",
    "start": "node dist/cli.js",
    "measure:snapshot": "tsx scripts/snapshot-size.ts",
    "smoke:bus": "tsx scripts/bus-smoke.ts",
    "smoke:commands": "tsx scripts/command-idempotency.ts",
    "smoke:restart": "tsx scripts/command-host-restart.ts",
    "smoke:pair-refresh": "tsx scripts/pair-refresh-smoke.ts",
    "smoke:multi-phone": "tsx scripts/smoke-multi-phone.ts",
    "smoke:ws": "tsx scripts/ws-subscribe.ts",
    "probe:capacity": "tsx scripts/capacity-probe.ts",
    "probe:latency": "tsx scripts/latency-probe.ts",
    "smoke:admin": "tsx scripts/admin-smoke.ts",
    "smoke:m0-e2e": "tsx scripts/m0-e2e.ts",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "e2e:host": "tsx scripts/e2e-host.ts",
    "smoke:m1-pairing": "tsx scripts/m1-pairing.ts",
    "smoke:m1-tunnel": "tsx scripts/m1-tunnel.ts",
    "smoke:m1-bus": "tsx scripts/m1-bus.ts",
    "smoke:m1-acp": "tsx scripts/m1-acp.ts",
    "smoke:m1-outage": "tsx scripts/m1-outage.ts",
    "list:agents": "tsx scripts/list-agents.ts",
    "probe:acp": "tsx scripts/acp-probe.ts",
    "test": "tsx --test --test-concurrency=1 --test-force-exit test/tunnel/*.test.ts test/bus/*.test.ts test/connectors/*.test.ts test/platform/*.test.ts test/desktop/*.test.ts",
    "desktop": "npm run build && electron .",
    "icons:tray": "node scripts/make-tray-icons.mjs"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "qrcode-generator": "^2.0.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "electron": "^45.2.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
